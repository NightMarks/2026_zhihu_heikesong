# ── 知乎开放平台凭证 ─────────────────────────────────
# 个人中心获取：https://developer.zhihu.com/profile
# 注意：这是服务端凭证，绝不能出现在前端代码或公开仓库
ZHIHU_ACCESS_SECRET=

# ── 知乎 OAuth 应用（用于"用知乎登录"）──────────────
# 需向 product-platform@zhihu.com 邮件申请，主题：
#   <公司名称>申请接入知乎 OAuth 服务
# 申请材料：应用名称、简介、回调地址、申请人姓名与手机号
#
# 读取优先级：真实环境变量 > 本文件。所以既可以写在 .env，
# 也可以在启动时注入，后者会覆盖本文件的同名项：
#   ZHIHU_APP_ID=xxx ZHIHU_APP_KEY=yyy npm start
# app_key 只在服务端用于换取 token，不会下发到浏览器。
ZHIHU_APP_ID=
ZHIHU_APP_KEY=

# 必须与申请时登记的回调地址完全一致
ZHIHU_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# 部署平台可只设置 PUBLIC_URL，服务端会自动生成 <PUBLIC_URL>/auth/callback。
# Render 会自动提供 RENDER_EXTERNAL_URL，因此通常无需手工设置 PUBLIC_URL。
PUBLIC_URL=

# 云服务器必须监听 0.0.0.0；本地也可以保持此默认值
HOST=0.0.0.0
PORT=3000
